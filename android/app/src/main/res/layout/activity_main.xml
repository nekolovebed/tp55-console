<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EPZ TP55"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROL CONSOLE"
                android:textColor="@color/dim"
                android:textSize="7sp"
                android:letterSpacing="0.22" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:background="@drawable/bg_chip"
            android:layout_marginEnd="8dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_off" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="未连接"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_btn_primary"
            android:text="保存"
            android:textColor="#140F22"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 内容 -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部导航 -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#F207090D">

        <LinearLayout
            android:id="@+id/tabEq"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_row">
            <TextView
                android:id="@+id/tabEqLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EQ"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="均衡器"
                android:textColor="@color/accent"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabDac"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_row">
            <TextView
                android:id="@+id/tabDacLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAC"
                android:textColor="@color/dim"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tabDacSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="解码"
                android:textColor="@color/dim"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabMic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_row">
            <TextView
                android:id="@+id/tabMicLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIC"
                android:textColor="@color/dim"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tabMicSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="麦克风"
                android:textColor="@color/dim"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabDevice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_row">
            <TextView
                android:id="@+id/tabDeviceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设备"
                android:textColor="@color/dim"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tabDeviceSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="信息"
                android:textColor="@color/dim"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
